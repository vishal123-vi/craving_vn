{
  "name": "cravings-app",
  "version": "1.0.0",
  "description": "Cravings - Full Stack Food Delivery Web Application (MERN Stack)",
  "scripts": {
    "start": "npm --prefix server start",
    "postinstall": "npm --prefix server install",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix server install",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "author": "Vishal Tiwari",
  "license": "ISC"
}
