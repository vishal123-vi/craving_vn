# Environment Mode (development | production)
NODE_ENV=production

# Server Port
PORT=5000

# Client Allowed Origin (for production CORS)
CLIENT_URL=https://craving-vn.netlify.app

# MongoDB Database Connection (Local or MongoDB Atlas Cloud)
MONGO_DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cravings_vn?retryWrites=true&w=majority

# JSON Web Token Secret
JWT_SECRET=your_super_strong_random_jwt_secret_key_2026

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gmail Nodemailer Configuration
GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSCODE=your_app_password

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Server-to-Server Webhook Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
